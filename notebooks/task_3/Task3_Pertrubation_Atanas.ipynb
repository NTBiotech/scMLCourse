   "source": [
    "## 3. Evaluation - Validation set \n",
    "\n",
    "Ref: https://developer.nvidia.com/blog/a-comprehensive-overview-of-regression-evaluation-metrics/"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "34d1649d-76eb-4262-9f3f-6b34405ba28b",
   "metadata": {},
   "source": [
    "### 3.0 Utility functions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 40,
   "id": "dc4027e3-479c-4b94-a48c-c11ed4d2c5d4",
   "metadata": {},
   "outputs": [],
   "source": [
    "def evaluate_model(y_true, y_pred, print_means=True):\n",
    "    r2 = r2_score(y_true, y_pred, multioutput=\"raw_values\", )\n",
    "    mae = mean_absolute_error(y_true, y_pred, multioutput=\"raw_values\", )\n",
    "    mse = mean_squared_error(y_true, y_pred, multioutput=\"raw_values\", )\n",
    "    rmse = np.sqrt(mse)\n",
    "\n",
    "    corr_list = []\n",
    "    for i in range(y_true.shape[0]):\n",
    "        corr = np.corrcoef(y_true[i,:], y_pred[i,:])\n",
    "        corr_list.append(corr[0,1])\n",
    "\n",
    "    if print_means:\n",
    "        print(\"R-squared: \", np.mean(r2))\n",
    "        print(\"Mean absolute error: \", np.mean(mae))\n",
    "        print(\"Mean squared error: \", np.mean(mse))\n",
    "        print(\"Root mean squared error:\", np.mean(rmse))\n",
    "        print('Pearson: ', np.mean(corr_list))\n",
    "    else:\n",
    "        print(\"R-squared: \", r2)\n",
    "        print(\"Mean absolute error: \", mae)\n",
    "        print(\"Mean squared error: \", mse)\n",
    "        print(\"Root mean squared error:\", rmse)\n",
    "        print('Pearson: ', np.array(corr_list))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 59,
   "id": "93c21126-a0de-403f-91e3-35a023ef1bc5",
   "metadata": {},
   "outputs": [],
   "source": [
    "def plot_residuals(y_true, y_pred, gene_names):\n",
    "    residuals = np.array(y_true - y_pred)\n",
    "    plt.figure(figsize=(12,5))\n",
    "    plt.title(\"Residuals Distribution\")\n",
    "    plt.boxplot(residuals)\n",
    "    plt.xticks(np.arange(len(gene_names))+1, gene_names, rotation=90)\n",
    "    plt.xlabel(\"Residuals (y_actual - y_predicted)\")\n",
    "    plt.ylabel('log2FC')\n",
    "    plt.show()\n",
    "\n",
    "def true_pred_scatter(y_true, y_pred, gene_names):\n",
    "    fig, ax = plt.subplots(nrows=6, ncols=5, figsize=(15, 25),)\n",
    "    c = 0 # Not ideal but will do for now\n",
    "    for i, row in enumerate(ax):\n",
    "        for j, col in enumerate(row):      \n",
    "            col.set_title('log2FC: '+gene_names[c])\n",
    "            col.set_xlabel(\"True\")\n",
    "            col.set_ylabel(\"Predicted\")\n",
    "            col.scatter(x=y_true[:,c], y=y_pred[:,c])\n",
    "            col.plot([min(y_true[:,c]), max(y_true[:,c])], \n",
    "             [min(y_true[:,c]), max(y_true[:,c])], color='red', linestyle='--')  # Perfect fit line\n",
    "            c += 1\n",
    "    # plt.subplots_adjust(wspace=0.4, hspace=0.6)\n",
    "    fig.tight_layout() # plt.tight_layout()\n",
    "    fig.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 68,
   "id": "27976381-94c8-41bd-a0cf-fa76d0cfc16f",
   "metadata": {},
   "outputs": [],
   "source": [
    "def full_eval(predictor, X_true, y_true, gene_names, print_means=False, plots=False):\n",
    "    y_pred = predictor.predict(X_true)\n",
    "    evaluate_model(y_true, y_pred, print_means=print_means)\n",
    "    if plots:\n",
    "        plot_residuals(y_true, y_pred, gene_names)\n",
    "        true_pred_scatter(y_true, y_pred, gene_names)"
   ]
  },
