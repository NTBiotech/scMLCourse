    "## Strategy 1\n",
    "log2fc_list = []\n",
    "for condition in perturbed_adata.obs['perturbation_2'].unique():\n",
    "    temp_adata = perturbed_adata[perturbed_adata.obs['perturbation_2']==condition].copy()\n",
    "    sc.tl.rank_genes_groups(temp_adata, \n",
    "                            groupby='sample', \n",
    "                            reference=f'control_{condition}',\n",
    "                            method='wilcoxon',)\n",
    "    log2fc = sc.get.rank_genes_groups_df(temp_adata,\n",
    "                                         group=None,)\n",
    "                                         # gene_symbols = 'ensembl_id')\n",
    "    del temp_adata\n",
    "    log2fc_list.append(log2fc)\n",
    "log2fc_df_long = pd.concat(log2fc_list)\n",
    "\n",
    "log2fc_df = log2fc_df_long.pivot(index='group', columns='names', values='logfoldchanges')\n",
    "print('Shape: ', log2fc_df.shape)\n",
    "log2fc_df.head()"
   ]
  },
